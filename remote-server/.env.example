# Use two different, randomly generated secrets with at least 16 characters.
ADMIN_TOKEN=replace-with-a-long-random-admin-secret
DEVICE_TOKEN=replace-with-a-different-device-secret
HOST=127.0.0.1
PORT=8080
# Optional, server-side only. GPT output is diagnostic advice and never executes commands.
OPENAI_API_KEY=
OPENAI_DIAGNOSTIC_MODEL=gpt-5-mini
