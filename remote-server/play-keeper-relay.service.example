[Unit]
Description=Play Keeper remote relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=playkeeper
WorkingDirectory=/opt/play-keeper/remote-server
EnvironmentFile=/etc/play-keeper-relay.env
Environment=AUTH_STORE_FILE=/var/lib/play-keeper/users.json
Environment=PLAN_SETTINGS_FILE=/var/lib/play-keeper/plan-schedule.json
Environment=PLAN_STATE_FILE=/var/lib/play-keeper/plan-state.json
Environment=PLAN_DIAGNOSTICS_DIR=/var/lib/play-keeper/diagnostics
ExecStart=/usr/bin/node /opt/play-keeper/remote-server/server.js
Restart=always
RestartSec=3
StateDirectory=play-keeper
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
